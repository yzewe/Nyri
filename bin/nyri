#!/usr/bin/env bash
set -uo pipefail

NYRI="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SHOTS="$HOME/Pictures/Screenshots"
CLIPS="$HOME/Videos/Recordings"

todo() { notify-send -a nyri "Nyri" "$1 — ещё не сделано"; }
hypr() { [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; }

qspid() {
    local p
    # Nix and other launchers can give Quickshell a process name other than `qs`.
    for p in $(qs -c nyri list -j 2>/dev/null | jq -r '.[].pid'); do
        if grep -qz '^NYRI_NESTED=1$' "/proc/$p/environ" 2>/dev/null; then
            [[ -n ${NYRI_NESTED:-} ]] && { echo "$p"; return; }
        else
            [[ -z ${NYRI_NESTED:-} ]] && { echo "$p"; return; }
        fi
    done
}
shell() { local pid; pid=$(qspid); [[ -n $pid ]] || return 1; qs -c nyri ipc --pid "$pid" call nyri "$@" &>/dev/null; }

menu() { fuzzel --dmenu --prompt "$1  " "${@:2}"; }

region() {
    local geom="${2:-}"
    case "${1:-screenshot}" in
        screenshot)
            [[ -n $geom ]] || { if hypr; then geom="$(slurp)" || return; else niri msg action screenshot; return; fi; }
            shot "$geom" ;;
        full)
            if hypr; then shot "$(slurp -o)"; else niri msg action screenshot-screen; fi ;;
        menu)
            pkill -INT -x wf-recorder && exit 0
            shell toggle snip || { if hypr; then region screenshot; else niri msg action screenshot; fi; } ;;
        edit)
            [[ -n $geom ]] || geom="$(slurp)" || exit 0
            grim -g "$geom" - | swappy -f - ;;
        ocr)
            local text
            [[ -n $geom ]] || geom="$(slurp)" || exit 0
            text="$(grim -g "$geom" - | tesseract - - -l "$(ocr_langs)" 2>/dev/null)"
            printf '%s' "$text" | wl-copy
            notify-send -a nyri "Текст скопирован" "${text:0:120}" ;;
        record)
            record "${3:-}" "$geom" ;;
        recordWithSound)
            record both "$geom" ;;
        search)
            lens "$geom" ;;
    esac
}

shot() {
    local file
    mkdir -p "$SHOTS"
    file="$SHOTS/$(date '+%Y-%m-%d %H-%M-%S').png"
    grim -g "$1" "$file" || exit 1
    wl-copy --type image/png < "$file"
    (
        a=$(notify-send -a "Снимок экрана" -i "$file" -A open=Открыть -A folder=Папка \
            "Снимок в буфере" "${file##*/}")
        case "$a" in open) xdg-open "$file" ;; folder) xdg-open "$SHOTS" ;; esac
    ) &
    disown
}

ocr_langs() {
    local have; have="$(tesseract --list-langs 2>/dev/null)"
    grep -qx rus <<<"$have" && echo "eng+rus" || echo "eng"
}

record() {
    if pkill -INT -x wf-recorder; then
        return
    fi
    local sound="${1:-}" geom="${2:-}" file sink src m
    local audio=() mods=()
    [[ -n $geom ]] || geom="$(slurp)" || exit 0
    mkdir -p "$CLIPS"
    file="$CLIPS/$(date +%Y-%m-%d_%H-%M-%S).mp4"
    sink="$(pactl get-default-sink 2>/dev/null)"
    src="$(pactl get-default-source 2>/dev/null)"
    case "$sound" in
        system) [[ -n $sink ]] && audio=("--audio=$sink.monitor") ;;
        mic)    [[ -n $src ]] && audio=("--audio=$src") ;;
        both)
            if m="$(pactl load-module module-null-sink sink_name=nyri_rec sink_properties=device.description=Nyri-запись 2>/dev/null)"; then
                mods+=("$m")
                [[ -n $sink ]] && m="$(pactl load-module module-loopback source="$sink.monitor" sink=nyri_rec latency_msec=30 2>/dev/null)" && mods+=("$m")
                [[ -n $src ]] && m="$(pactl load-module module-loopback source="$src" sink=nyri_rec latency_msec=30 2>/dev/null)" && mods+=("$m")
                [[ -n $sink ]] && pactl set-default-sink "$sink"
                audio=("--audio=nyri_rec.monitor")
            fi ;;
    esac
    shell recording true
    (
        wf-recorder "${audio[@]}" -g "$geom" -f "$file" &>/dev/null
        for m in "${mods[@]}"; do pactl unload-module "$m" 2>/dev/null; done
        shell recording false
        a=$(notify-send -a "Запись экрана" -i video-x-generic -A open=Открыть -A folder=Папка \
            "Запись сохранена" "${file##*/}")
        case "$a" in open) xdg-open "$file" ;; folder) xdg-open "$CLIPS" ;; esac
    ) &
    disown
}

lens() {
    local geom="${1:-}" tmp url
    [[ -n $geom ]] || geom="$(slurp)" || exit 0
    tmp="$(mktemp --suffix=.png)"
    grim -g "$geom" "$tmp"
    url="$(curl -sf -F reqtype=fileupload -F time=1h -F "fileToUpload=@$tmp" \
        https://litterbox.catbox.moe/resources/internals/api.php)"
    rm -f "$tmp"
    if [[ $url == https://* ]]; then
        xdg-open "https://lens.google.com/uploadbyurl?url=$url"
    else
        notify-send -a nyri -u critical "Поиск по области" "Не удалось загрузить картинку"
    fi
}

picker() {
    local c; c="$(hyprpicker -a -f hex 2>/dev/null)" || exit 0
    [[ -n $c ]] && notify-send -a "Пипетка" -i color-select "$c" "Скопирован в буфер обмена"
}

clipboard() {
    local pick; pick="$(cliphist list | menu "󰅌")" || exit 0
    cliphist decode <<<"$pick" | wl-copy
}

wallpaper() {
    local pick
    pick="$(find "$NYRI/wallpapers" "$HOME/Pictures/Wallpapers" -maxdepth 1 -type f \
                \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null \
            | while read -r f; do printf '%s\t%s\n' "${f##*/}" "$f"; done \
            | menu "󰸉" --with-nth=1 --accept-nth=2)" || exit 0
    "$NYRI/bin/nyri-theme" "$pick"
}

session() {
    local pick
    pick="$(printf '%s\n' "󰌾  Заблокировать" "󰤄  Сон" "󰍃  Выйти" "󰜉  Перезагрузить" "󰐥  Выключить" \
            | menu "" --lines=5 --width=24)" || exit 0
    case "$pick" in
        *Заблокировать) lock ;;
        *Сон)           lock & sleep 0.5; systemctl suspend ;;
        *Выйти)         if hypr; then hyprctl dispatch exit; else niri msg action quit --skip-confirmation; fi ;;
        *Перезагрузить) systemctl reboot ;;
        *Выключить)     systemctl poweroff ;;
    esac
}

lock() { pidof hyprlock >/dev/null || hyprlock; }

audio() {
    if [[ "$1" == volumeUp || "$1" == volumeDown ]]; then
        case "$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)" in
            *MUTED*) return 0 ;;
        esac
    fi
    case "$1" in
        volumeUp)   wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
        volumeDown) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
        mute)       wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
        micMute)    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    esac
}

brightness() {
    case "$1" in
        increment) brightnessctl -q -e4 -n2 set 5%+ ;;
        decrement) brightnessctl -q -e4 -n2 set 5%- ;;
    esac
    shell osd brightness
}

mpris() {
    case "$1" in
        playPause) playerctl play-pause ;;
        next)      playerctl next ;;
        previous)  playerctl previous ;;
    esac
}

action="${1:-}"; shift || true
case "$action" in
    terminal)   exec kitty ;;
    browser)    exec zen-browser ;;
    launcher)   shell toggle launcher || exec fuzzel ;;
    clipboard)  shell toggle clipboard || clipboard ;;
    region)     region "$@" ;;
    wallpaper)  shell toggle wallpaper || wallpaper ;;
    session)    shell toggle session || session ;;
    lock)       shell lock || lock ;;
    cheatsheet) if hypr; then shell settingsAt keys; else niri msg action show-hotkey-overlay; fi ;;
    switcher)   shell switcher "${1:-next}" || { if hypr; then hyprctl dispatch cyclenext; else niri msg action focus-window-previous; fi; } ;;
    audio)      audio "$@" ;;
    brightness) brightness "$@" ;;
    mpris)      mpris "$@" ;;
    crosshair)  shell crosshair || todo "Прицел" ;;
    picker)     picker ;;
    settings)   shell settings || todo "Настройки" ;;
    sidebar)    shell toggle control || todo "Правая панель" ;;
    panels)     shell autohide || todo "Автоскрытие панели" ;;
    *)          echo "usage: nyri <action> [args]" >&2; exit 2 ;;
esac
