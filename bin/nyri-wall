#!/usr/bin/env python3
"""Flat vector wallpapers with swappable palettes (after the wally app).

    nyri-wall styles                                 JSON list of styles
    nyri-wall palettes                               JSON list of palettes
    nyri-wall make STYLE PALETTE SEED OUT.svg [--size WxH] [--grid] [--scale K] [--scene OUT.json]
    nyri-wall thumbs PALETTE SEED DIR [--grid] [--scale K]  every style as DIR/<style>.svg
    nyri-wall apply STYLE PALETTE SEED [--grid] [--scale K] render, save, recolor the desktop
    nyri-wall variant dark|light                     the current wallpaper for night / day
    nyri-wall scene [PNG]                            the current wallpaper's scene, as PNG's .json

PALETTE is a palette name ("Терракота", or "Терракота/dark" and
"Терракота/light" for its dark and light versions), or a colour — "#7c4dff" (light) or "#7c4dff/dark"
— to build the whole palette from that one hue. --grid adds graph paper;
--scale sizes the pattern (1 as designed; 0.5 twice as small and denser, 2
twice as big). `variant dark` redraws the current wallpaper in the dark version of
its palette (the day one is remembered); `variant light` brings
the day one back. Both recolour the desktop in that mode.

A wallpaper is a pure function of (style, palette, seed, size): no effects,
no gradients, just shapes — so any palette can be swapped in later. `apply`
writes $NYRI_DATA/walls/<style>-<palette>-<seed>.{svg,png} (NYRI_DATA
defaults to ~/.local/share/nyri; the PNG is what matugen reads) and runs
nyri-theme on it.
"""
import colorsys, hashlib, json, math, os, random, re, subprocess, sys
from pathlib import Path

W, H = 2880, 1800

def P(group, name, *c):
    return {"group": group, "name": name, "colors": ["#%06x" % (v & 0xFFFFFF) for v in c]}

