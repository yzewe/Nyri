def hexrgb(h):
    return tuple(int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))

def rgbhex(r, g, b):
    return "#%02x%02x%02x" % tuple(round(max(0, min(1, v)) * 255) for v in (r, g, b))

def shift(hex_, dl):
    h, l, s_ = colorsys.rgb_to_hls(*hexrgb(hex_))
    return rgbhex(*colorsys.hls_to_rgb(h, max(0, min(1, l + dl)), s_))

def custom_palette(spec):
    base, _, variant = spec.partition("/")
    h, _, s_ = colorsys.rgb_to_hls(*hexrgb(base))
    s_ = max(0.35, s_)
    def tone(l, sat, dh=0.0):
        return rgbhex(*colorsys.hls_to_rgb((h + dh) % 1, l, min(1, sat)))
    if variant == "dark":
        return [tone(0.1, s_ * 0.45), tone(0.28, s_ * 0.7, -0.01), tone(0.46, s_ * 0.85), tone(0.66, s_ * 0.9, 0.015), tone(0.84, s_ * 0.6, 0.02)]
    return [tone(0.9, s_ * 0.55), tone(0.22, s_ * 0.65, -0.01), tone(0.42, s_ * 0.85), tone(0.62, s_ * 0.9, 0.015), tone(0.78, s_ * 0.75, 0.02)]

def toned(colors, variant):
    def hls(c):
        return colorsys.rgb_to_hls(*hexrgb(c))
    bh, bl, bs = hls(colors[0])
    out = []
    if variant == "dark":
        out.append(rgbhex(*colorsys.hls_to_rgb(bh, 0.1, min(bs, 0.4))))
        for c in colors[1:]:
            h, l, s_ = hls(c)
            out.append(rgbhex(*colorsys.hls_to_rgb(h, 0.2 + l * 0.46, min(1, s_ * 1.05))))
    else:
        out.append(rgbhex(*colorsys.hls_to_rgb(bh, 0.93, min(bs, 0.55))))
        for c in colors[1:]:
            h, l, s_ = hls(c)
            out.append(rgbhex(*colorsys.hls_to_rgb(h, 0.5 + l * 0.38, min(1, s_ * 1.05))))
    return out

def luminance(hex_):
    r, g, b = (int(hex_[i:i + 2], 16) / 255 for i in (1, 3, 5))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

TAU = 2 * math.pi

def f(v):
    return f"{v:.1f}"

def smooth(points, closed=True):
    n = len(points)
    pts = points if closed else [points[0]] + points + [points[-1]]
    d = f"M{f(points[0][0])},{f(points[0][1])}"
    rng = range(n) if closed else range(1, len(pts) - 2)
    for i in rng:
        p0, p1, p2, p3 = (pts[(i - 1) % len(pts)], pts[i % len(pts)], pts[(i + 1) % len(pts)], pts[(i + 2) % len(pts)])
        c1 = (p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6)
        c2 = (p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6)
        d += f" C{f(c1[0])},{f(c1[1])} {f(c2[0])},{f(c2[1])} {f(p2[0])},{f(p2[1])}"
    return d + (" Z" if closed else "")

def polar(cx, cy, radius_fn, steps=96, rot=0.0):
    pts = []
    for i in range(steps):
        t = 2 * math.pi * i / steps
        r = radius_fn(t)
        pts.append((cx + r * math.cos(t + rot), cy + r * math.sin(t + rot)))
    return smooth(pts)

def circ_d(x, y, r):
    return f"M{f(x - r)},{f(y)} A{f(r)},{f(r)} 0 1 1 {f(x + r)},{f(y)} A{f(r)},{f(r)} 0 1 1 {f(x - r)},{f(y)} Z"

def ccw_circ_d(x, y, r):
    return f"M{f(x - r)},{f(y)} A{f(r)},{f(r)} 0 1 0 {f(x + r)},{f(y)} A{f(r)},{f(r)} 0 1 0 {f(x - r)},{f(y)} Z"

def ell_d(x, y, rx, ry):
    return f"M{f(x - rx)},{f(y)} A{f(rx)},{f(ry)} 0 1 1 {f(x + rx)},{f(y)} A{f(rx)},{f(ry)} 0 1 1 {f(x - rx)},{f(y)} Z"

def rrect_d(x, y, w, h, r=0.0, rot=0.0, o=None):
    r = max(0.0, min(r, w / 2, h / 2))
    ox, oy = o if o else (x + w / 2, y + h / 2)
    ca, sa = math.cos(math.radians(rot)), math.sin(math.radians(rot))

    def P(px, py):
        dx, dy = px - ox, py - oy
        return f"{f(ox + dx * ca - dy * sa)},{f(oy + dx * sa + dy * ca)}"
    if r < 0.05:
        return f"M{P(x, y)} L{P(x + w, y)} L{P(x + w, y + h)} L{P(x, y + h)} Z"
    a = f"A{f(r)},{f(r)} 0 0 1"
    return (f"M{P(x + r, y)} L{P(x + w - r, y)} {a} {P(x + w, y + r)} L{P(x + w, y + h - r)} {a} {P(x + w - r, y + h)}"
            f" L{P(x + r, y + h)} {a} {P(x, y + h - r)} L{P(x, y + r)} {a} {P(x + r, y)} Z")

def fill(d, col, op=1.0):
    return {"d": d, "f": col, **({"op": op} if op < 1 else {})}

def line(d, col, sw, op=1.0, cap="round"):
    return {"d": d, "s": col, "w": round(sw, 2), "cap": cap, **({"op": op} if op < 1 else {})}

def spin(c, lo, hi, sign=None):
    return {"k": "spin", "v": round(c.mr.uniform(lo, hi) * (sign or c.mr.choice([1, -1])), 3)}

def sway(c, a, lo, hi, ph=None):
    return {"k": "sway", "a": round(a, 3), "p": round(c.mr.uniform(lo, hi), 2), "ph": round(c.mr.uniform(0, TAU) if ph is None else ph, 3)}

def bob(c, dx, dy, lo, hi, ph=None):
    return {"k": "bob", "dx": round(dx, 2), "dy": round(dy, 2), "p": round(c.mr.uniform(lo, hi), 2), "ph": round(c.mr.uniform(0, TAU) if ph is None else ph, 3)}

def breathe(c, a, lo, hi, ph=None):
    return {"k": "breathe", "a": round(a, 4), "p": round(c.mr.uniform(lo, hi), 2), "ph": round(c.mr.uniform(0, TAU) if ph is None else ph, 3)}

def stretch(c, a, lo, hi):
    return {"k": "stretch", "a": round(a, 4), "p": round(c.mr.uniform(lo, hi), 2), "ph": round(c.mr.uniform(0, TAU), 3)}

def twinkle(c, a, lo, hi):
    return {"k": "twinkle", "a": round(a, 3), "p": round(c.mr.uniform(lo, hi), 2)}

def flip(c, lo, hi, step=90):
    e = c.mr.uniform(lo, hi)
    return {"k": "flip", "e": round(e, 2), "ph": round(c.mr.uniform(1, e), 2), "st": step * c.mr.choice([1, -1])}

def drift(c, v, x0, bw):
    return {"k": "drift", "v": round(v, 2), "x0": round(x0, 1), "bw": round(bw, 1), "W": c.w}

def orbit(c, rx, ry, lo, hi):
    return {"k": "orbit", "rx": round(rx, 1), "ry": round(ry, 1), "p": round(c.mr.uniform(lo, hi), 1) * c.mr.choice([1, -1]), "ph": round(c.mr.uniform(0, TAU), 3)}

def at_rest_scale(m):
    for x in m:
        if x["k"] == "swell":
            return x["s0"] if x["s0"] > 1e-4 else None
        if x["k"] == "ripple":
            s = 0.5 + 0.5 * math.cos(x["d"] * x["n"])
            return s if s >= x["min"] else None
    return 1.0

class Canvas:
    def __init__(self, w, h, palette, grid=False, scale=1.0):
        self.w, self.h = w, h
        self.k = max(0.3, min(3.0, scale))
        self.u = h * self.k
        self.bg = palette[0]
        self.fg = palette[1:]
        self.grid = grid
        self.mr = random.Random(0)
        self.nodes = []
        self.stack = [self.nodes]
        self.fx = []

    def n(self, count, power=1, lo=1, hi=400):
        return max(lo, min(hi, int(round(count / self.k ** power))))

    def put(self, node):
        self.stack[-1].append(node)
        return node

    def node(self, paths, r=0.0, o=(0, 0), m=None):
        return self.put({"p": paths, "r": round(r, 2), "o": [round(o[0], 1), round(o[1], 1)], "m": m or []})

    def circle(self, x, y, r, c, m=None):
        return self.put({"t": "dot", "x": round(x, 1), "y": round(y, 1), "rad": round(r, 2), "f": c, "m": m or []})

    def rect(self, x, y, w, h, c, r=0, rot=0, m=None, o=None):
        o = o or (x + w / 2, y + h / 2)
        return self.node([fill(rrect_d(x, y, w, h, r, 0, o), c)], rot, o, m)

    def path(self, d, c, rot=0, o=(0, 0), m=None):
        return self.node([fill(d, c)], rot, o, m)

    def group(self, tf):
        g = self.put({"g": tf, "c": []})
        self.stack.append(g["c"])

    def end(self):
        self.stack.pop()

    def grid_outside(self, cx, cy, R):
        step = min(self.w, self.h) / 14
        d = []
        def seg(a, b, vertical, at):
            if b - a > 0.5:
                d.append(f"M{f(at)},{f(a)} L{f(at)},{f(b)}" if vertical else f"M{f(a)},{f(at)} L{f(b)},{f(at)}")
        for vertical, span, n, c0, c1 in ((True, self.h, int(self.w / step), cx, cy), (False, self.w, int(self.h / step), cy, cx)):
            for i in range(1, n + 1):
                at = i * step
                off = abs(at - c0)
                if off >= R:
                    seg(0, span, vertical, at)
                    continue
                h = math.sqrt(R * R - off * off)
                seg(0, min(span, c1 - h), vertical, at)
                seg(max(0, c1 + h), span, vertical, at)
        return " ".join(d)

    @staticmethod
    def sine_d(y, amp, period, ph, x0, x1):
        n = max(64, int((x1 - x0) / period * 48))
        return "M" + " L".join(f"{f(x0 + (x1 - x0) * i / n)},{f(y + amp * math.sin(ph + TAU * (x0 + (x1 - x0) * i / n) / period))}" for i in range(n + 1))

    def flow(self, v, period):
        return [{"k": "scroll", "v": round(-v * period / TAU, 3), "P": round(period, 2)}]

    def wave(self, y, amp, period, ph, col, v, x0=-40.0, x1=None):
        x1 = self.w + 40 if x1 is None else x1
        a, b = x0 - period, x1 + period
        d = self.sine_d(y, amp, period, ph, a, b) + f" L{f(b)},{f(self.h + 40)} L{f(a)},{f(self.h + 40)} Z"
        return self.node([fill(d, col)], 0, (0, 0), self.flow(v, period))

    def ribbon(self, y, amp, period, ph, width, col, v, x0, x1):
        return self.node([line(self.sine_d(y, amp, period, ph, x0 - period, x1 + period), col, width)], 0, (0, 0), self.flow(v, period))

    def grid_spec(self):
        step = min(self.w, self.h) / 14
        col = shift(self.bg, -0.05 if luminance(self.bg) > 0.5 else 0.06)
        sw = max(1.5, min(self.w, self.h) / 600)
        d = "".join(f"M{f(x)},0 L{f(x)},{self.h} " for x in [i * step for i in range(1, int(self.w / step) + 1)])
        d += "".join(f"M0,{f(y)} L{self.w},{f(y)} " for y in [i * step for i in range(1, int(self.h / step) + 1)])
        return {"d": d.strip(), "s": col, "w": round(sw, 2)}

    def svg(self):
        def paths(ps):
            out = ""
            for p in ps:
                op = p.get("op", 1)
                if "s" in p:
                    out += (f'<path d="{p["d"]}" fill="none" stroke="{p["s"]}" stroke-width="{p["w"]}" stroke-linecap="{p["cap"]}" stroke-linejoin="round"'
                            + (f' stroke-opacity="{op}"' if op < 1 else "") + "/>")
                else:
                    out += f'<path d="{p["d"]}" fill="{p["f"]}"' + (f' fill-opacity="{op}"' if op < 1 else "") + "/>"
            return out

        def tfs(tf):
            out = []
            for t in tf:
                if t[0] == "translate":
                    out.append(f"translate({f(t[1])} {f(t[2])})")
                elif t[0] == "scale":
                    out.append(f"scale({t[1]})")
                else:
                    out.append(f"rotate({f(t[1])} {f(t[2])} {f(t[3])})")
            return " ".join(out)

        def emit(nodes):
            out = []
            for n in nodes:
                if "g" in n:
                    out.append(f'<g transform="{tfs(n["g"])}">' + emit(n["c"]) + "</g>")
                    continue
                t = n.get("t")
                s0 = at_rest_scale(n["m"])
                if s0 is None:
                    continue
                if t == "dot":
                    out.append(f'<circle cx="{f(n["x"])}" cy="{f(n["y"])}" r="{f(n["rad"] * s0)}" fill="{n["f"]}"/>')
                    continue
                ox, oy = n["o"]
                tf = []
                if n["r"]:
                    tf.append(f"rotate({f(n['r'])} {f(ox)} {f(oy)})")
                if abs(s0 - 1) > 1e-4:
                    tf.append(f"translate({f(ox)} {f(oy)}) scale({s0:.4f}) translate({f(-ox)} {f(-oy)})")
                inner = paths(n["p"])
                out.append(f'<g transform="{" ".join(tf)}">{inner}</g>' if tf else inner)
            return "".join(out)

        grid = ""
        if self.grid:
            g = self.grid_spec()
            grid = f'<path d="{g["d"]}" stroke="{g["s"]}" stroke-width="{g["w"]}" fill="none"/>'
        return (f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {self.w} {self.h}" width="{self.w}" height="{self.h}">'
                f'<rect width="{self.w}" height="{self.h}" fill="{self.bg}"/>' + grid + emit(self.nodes) + "</svg>")

    def scene(self):
        def still(n):
            return "p" in n and not n["m"] and not n["r"]

        def merge(nodes):
            out = []
            for n in nodes:
                if "g" in n:
                    out.append({"g": n["g"], "c": merge(n["c"])})
                elif still(n) and out and still(out[-1]):
                    out[-1]["p"].extend(dict(p) for p in n["p"])
                elif still(n):
                    out.append({"p": [dict(p) for p in n["p"]], "r": 0, "o": [0, 0], "m": []})
                else:
                    out.append(n)
            for n in out:
                if "p" in n:
                    ps = []
                    for p in n["p"]:
                        if ps and "f" in p and "f" in ps[-1] and p["f"] == ps[-1]["f"] and p.get("op", 1) == ps[-1].get("op", 1):
                            ps[-1]["d"] += " " + p["d"]
                        else:
                            ps.append(p)
                    n["p"] = ps
            return out

        return {"w": self.w, "h": self.h, "bg": self.bg, "grid": self.grid_spec() if self.grid else None,
                "fx": self.fx, "nodes": merge(self.nodes)}

def bauhaus(c, r):
    cols = c.n(r.choice([6, 7, 8, 9]), lo=2)
    s = c.w / cols
    rows = math.ceil(c.h / s)
    oy = (c.h - rows * s) / 2
    colors = [c.bg] + c.fg
    for j in range(rows):
        for i in range(cols):
            x, y = i * s, oy + j * s
            base = r.choice(colors)
            ink = r.choice([k for k in colors if k != base])
            c.rect(x - 0.75, y - 0.75, s + 1.5, s + 1.5, base)
            kind = r.choice(["circle", "ring", "half", "quarter", "tri", "circle", "quarter", "half"])
            cx, cy = x + s / 2, y + s / 2
            k = (s + 2) / s
            S = s + 2
            X, Y = cx - S / 2, cy - S / 2
            if kind == "circle":
                c.node([fill(circ_d(cx, cy, s * 0.36 * k), ink)], 0, (cx, cy), [breathe(c, 0.08, 3.5, 6.5)])
            elif kind == "ring":
                inner = r.choice([q for q in colors if q != ink])
                c.node([fill(circ_d(cx, cy, s * 0.4 * k), ink), fill(circ_d(cx, cy, s * 0.18 * k), inner)], 0, (cx, cy), [breathe(c, 0.07, 4, 7)])
            else:
                d = r.choice([0, 90, 180, 270])
                if kind == "half":
                    p = f"M{f(X)},{f(Y + S)} A{f(S / 2)},{f(S / 2)} 0 0 1 {f(X + S)},{f(Y + S)} Z"
                elif kind == "quarter":
                    p = f"M{f(X)},{f(Y + S)} L{f(X)},{f(Y)} A{f(S)},{f(S)} 0 0 1 {f(X + S)},{f(Y + S)} Z"
                else:
                    p = f"M{f(X)},{f(Y)} L{f(X + S)},{f(Y + S)} L{f(X)},{f(Y + S)} Z"
                c.node([fill(p, ink)], d, (cx, cy), [flip(c, 9, 26)])

def arches(c, r):
    cols = c.n(r.choice([5, 6]), lo=2)
    unit = c.w / cols
    rows = math.ceil(c.h / unit) + 2
    bands = r.choice([4, 5])
    for j in range(rows):
        off = unit / 2 if j % 2 else 0
        for i in range(-1, cols + 1):
            cx = i * unit + unit / 2 + off
            base = (j + 1) * unit * 0.95 - unit * 0.3
            seq = r.sample(c.fg, len(c.fg))
            ps = []
            for b in range(bands):
                rad = unit / 2 * (1 - b / bands)
                col = seq[b % len(seq)] if b < bands - 1 else c.bg
                ps.append(fill(f"M{f(cx - rad)},{f(base + unit)} L{f(cx - rad)},{f(base)} A{f(rad)},{f(rad)} 0 0 1 {f(cx + rad)},{f(base)} L{f(cx + rad)},{f(base + unit)} Z", col))
            c.node(ps, 0, (cx, base), [bob(c, 0, unit * 0.022, 6.5, 6.5, ph=-(cx / c.w) * 5 - j * 0.7)])

def waves(c, r):
    colors = [c.bg] + c.fg
    band_h = c.h / len(colors)
    way = c.mr.choice([1, -1])
    for k in range(1, len(colors)):
        y = band_h * k
        amp = min(c.u * r.uniform(0.02, 0.045), band_h * 0.18)
        freq = r.choice([1, 1.5, 2]) / c.k
        ph = r.uniform(0, 2 * math.pi)
        c.wave(y, amp, c.w / freq, ph, colors[k], way * c.mr.uniform(0.25, 0.4) * (1 + 0.35 * k / len(colors)))

def hills(c, r):
    sun = r.choice(c.fg)
    sx, sy, sr = c.w * r.uniform(0.2, 0.8), c.h * r.uniform(0.3, 0.45), c.u * r.uniform(0.14, 0.2)
    c.circle(sx, sy, sr, sun, [breathe(c, 0.025, 8, 12)])
    layers = [k for k in c.fg if k != sun] or c.fg
    layers = sorted(layers, key=luminance, reverse=luminance(c.bg) < 0.5)
    while len(layers) < 4:
        layers = layers + layers[-1:]
    for k, col in enumerate(layers[:4]):
        base = c.h * (0.5 + 0.13 * k)
        amp = c.u * r.uniform(0.05, 0.12)
        ph = r.uniform(0, 6)
        pts = [(x, base - amp * (0.6 * math.sin(ph + 2 * math.pi * x / (c.w * c.k) * r.uniform(0.8, 1.4)) + 0.4 * math.sin(ph * 2 + 5 * math.pi * x / (c.w * c.k))))
               for x in [c.w * t / c.n(10, lo=10) for t in range(-1, c.n(10, lo=10) + 2)]]
        d = smooth(pts, closed=False) + f" L{f(c.w + 40)},{f(c.h + 40)} L{f(-40)},{f(c.h + 40)} Z"
        c.path(d, col)
    cloud = max(c.fg, key=luminance) if luminance(c.bg) < 0.5 else max([c.bg] + c.fg, key=luminance)
    wind = c.mr.choice([1, -1])
    for _ in range(r.choice([2, 3])):
        cx, cy, w = c.w * r.uniform(0.1, 0.9), c.h * r.uniform(0.12, 0.3), c.w * c.k * r.uniform(0.09, 0.14)
        if abs(cx - sx) < sr + w * 0.7:
            cx = (sx + sr + w) % c.w if sx < c.w / 2 else max(w, sx - sr - w)
        h = w * 0.2
        ps = [fill(rrect_d(cx - w / 2, cy, w, h, h / 2), cloud)]
        for fx, fr in ((0.3, 0.22), (0.52, 0.3), (0.74, 0.18)):
            ps.append(fill(circ_d(cx - w / 2 + w * fx, cy + h * 0.2, w * fr * 0.62), cloud))
        c.node(ps, 0, (cx, cy), [drift(c, wind * c.mr.uniform(9, 18) * c.w / 2880, cx - w / 2, w)])

def pebbles(c, r):
    placed = []
    tries = 0
    while len(placed) < c.n(14, 2) and tries < c.n(900, 2, hi=20000):
        tries += 1
        rad = c.u * r.uniform(0.09, 0.2)
        x, y = r.uniform(-rad * 0.3, c.w + rad * 0.3), r.uniform(-rad * 0.3, c.h + rad * 0.3)
        if all(math.hypot(x - px, y - py) > (rad + pr) * 0.92 for px, py, pr in placed):
            placed.append((x, y, rad))
            phases = [r.uniform(0, 6) for _ in range(3)]
            fn = lambda t, rad=rad, ph=phases: rad * (1 + 0.08 * math.sin(2 * t + ph[0]) + 0.05 * math.sin(3 * t + ph[1]) + 0.03 * math.sin(5 * t + ph[2]))
            col = r.choice(c.fg)
            ps = [fill(polar(x, y, fn, 48, r.uniform(0, 6)), col)]
            if r.random() < 0.3:
                inner = r.choice([k for k in [c.bg] + c.fg if k != col])
                ps.append(fill(polar(x + rad * 0.08, y - rad * 0.05, lambda t, fn=fn: fn(t) * 0.5, 48, r.uniform(0, 6)), inner))
            a = c.mr.uniform(0, TAU)
            c.node(ps, 0, (x, y), [sway(c, c.mr.uniform(3, 6), 8, 13),
                                   bob(c, math.cos(a) * rad * 0.05, math.sin(a) * rad * 0.05, 6, 10)])
    for _ in range(c.n(r.choice([0, 12, 24]), 2, lo=0)):
        c.circle(r.uniform(0, c.w), r.uniform(0, c.h), c.u * r.uniform(0.004, 0.008), r.choice(c.fg))

def ribbons(c, r):
    n = c.n(r.choice([4, 5, 6]), lo=2, hi=40)
    tilt = r.uniform(-16, 16)
    c.group([["rotate", tilt, c.w / 2, c.h / 2], ["scale", 1.25], ["translate", -c.w * 0.1, -c.h * 0.1]])
    way = c.mr.choice([1, -1])
    for k in range(n):
        width = c.u * r.uniform(0.09, 0.15)
        y0 = c.h * (0.1 + 0.8 * k / max(1, n - 1)) + c.h * r.uniform(-0.05, 0.05)
        amp, freq, ph = c.u * r.uniform(0.08, 0.16), r.uniform(0.7, 1.3) / c.k, r.uniform(0, 6)
        steps = c.n(6, lo=6)
        c.ribbon(y0, amp, TAU * c.w / (6 * freq), ph, width, c.fg[k % len(c.fg)], way * c.mr.uniform(0.35, 0.6),
                 -c.w / steps, c.w * (steps + 1) / steps)
    c.end()

def shapes(c, r):
    def cookie(n, a):
        return lambda t, R: R * (1 + a * math.cos(n * t))

    kinds = [cookie(9, 0.07), cookie(4, 0.14), cookie(8, 0.06), cookie(12, 0.04), cookie(6, 0.1), cookie(4, 0.26), None, "pill", "arch"]
    placed = []
    tries = 0
    while len(placed) < c.n(12, 2) and tries < c.n(900, 2, hi=20000):
        tries += 1
        R = c.u * r.uniform(0.1, 0.22)
        x, y = r.uniform(-R * 0.4, c.w + R * 0.4), r.uniform(-R * 0.4, c.h + R * 0.4)
        if not all(math.hypot(x - px, y - py) > (R + pr) * 0.95 for px, py, pr in placed):
            continue
        placed.append((x, y, R))
        col = r.choice(c.fg)
        kind = r.choice(kinds)
        rot = r.uniform(0, 360)
        a = c.mr.uniform(0, TAU)
        drift_ = bob(c, math.cos(a) * R * 0.06, math.sin(a) * R * 0.06, 7, 12)
        if kind is None:
            c.circle(x, y, R, col, [breathe(c, 0.06, 4, 7), drift_])
        elif kind == "pill":
            c.node([fill(rrect_d(x - R, y - R * 0.5, 2 * R, R, R * 0.5), col)], rot, (x, y), [sway(c, c.mr.uniform(10, 20), 5, 9), drift_])
        elif kind == "arch":
            c.node([fill(f"M{f(x - R)},{f(y + R)} L{f(x - R)},{f(y)} A{f(R)},{f(R)} 0 0 1 {f(x + R)},{f(y)} L{f(x + R)},{f(y + R)} Z", col)],
                   rot, (x, y), [sway(c, c.mr.uniform(8, 16), 6, 10), drift_])
        else:
            c.node([fill(polar(x, y, lambda t, k=kind, R=R: k(t, R) * 0.92, 120, math.radians(rot)), col)], 0, (x, y),
                   [spin(c, 4, 12)] + ([breathe(c, 0.04, 5, 8)] if c.mr.random() < 0.4 else []) + [drift_])

def rainbow(c, r):
    corner = r.choice([(0, c.h), (c.w, c.h), (c.w / 2, c.h), (0, 0)])
    n = c.n(r.choice([6, 7, 8]), lo=4, hi=40)
    maxr = math.hypot(c.w, c.h) * r.uniform(0.7, 0.95) * max(1, c.k)
    L = len(c.fg)
    band = maxr / (n + 1)
    cycle = L * c.mr.uniform(3.2, 4.2)
    for k in range(n + L):
        start, end = maxr - k * band, maxr - (k - L) * band
        s0 = max(0.0, start / end)
        c.node([fill(circ_d(corner[0], corner[1], end), c.fg[k % L])], 0, corner,
               [{"k": "swell", "s0": round(s0, 5), "p": round(cycle, 2)}])
    c.circle(corner[0], corner[1], band, c.bg)
    far = math.hypot(c.w, c.h) * 2 + maxr
    c.node([fill(circ_d(corner[0], corner[1], far) + " " + ccw_circ_d(corner[0], corner[1], maxr), c.bg)])
    if c.grid:
        g = c.grid_spec()
        c.node([line(c.grid_outside(corner[0], corner[1], maxr), g["s"], g["w"], cap="butt")])

def dots(c, r):
    cols = c.n(24, lo=6)
    s = c.w / cols
    rows = math.ceil(c.h / s)
    fx, fy = r.uniform(0.2, 0.8) * c.w, r.uniform(0.2, 0.8) * c.h
    ink = c.fg[:3]
    maxd = math.hypot(c.w, c.h)
    hexgrid = r.random() < 0.5
    w = c.mr.uniform(0.7, 1.0)
    for j in range(rows + 1):
        for i in range(cols + 1):
            x, y = i * s + (s / 2 if hexgrid and j % 2 else 0), j * s
            d = math.hypot(x - fx, y - fy) / maxd
            if d > 0.42:
                continue
            c.circle(x, y, s * 0.45, ink[(i + j) % len(ink)] if len(ink) > 1 else ink[0],
                     [{"k": "ripple", "d": round(d, 4), "n": round(2.4 * math.pi, 4), "w": round(w, 3), "min": 0.134}])

def cosmos(c, r):
    for _ in range(c.n(90, 2)):
        x, y, s = r.uniform(0, c.w), r.uniform(0, c.h), r.uniform(3, 9) * c.k
        c.circle(x, y, s, c.fg[-1], [twinkle(c, c.mr.uniform(0.4, 0.85), 1.8, 6)])
    mx, my, mR = c.w * r.uniform(0.6, 0.9), c.h * r.uniform(0.15, 0.35), c.u * 0.08
    placed = [(mx, my, mR * 1.6, mR * 1.6)]
    want = c.n(r.choice([2, 3]), 2, hi=14)
    tries = 0
    planets = []
    while len(planets) < want and tries < 600:
        tries += 1
        R = c.u * r.uniform(0.1, 0.3) * (1 if tries < 200 else 0.7)
        x, y = c.w * r.uniform(0.1, 0.9), c.h * r.uniform(0.15, 0.85)
        rx, ry = R * 2.0, R * 1.25
        if any(abs(x - px) < rx + prx and abs(y - py) < ry + pry and
               ((x - px) / (rx + prx)) ** 2 + ((y - py) / (ry + pry)) ** 2 < 1 for px, py, prx, pry in placed):
            continue
        placed.append((x, y, rx, ry))
        planets.append((x, y, R))
    for x, y, R in planets:
        col = r.choice(c.fg)
        tilt = r.uniform(-25, 25)
        ring = r.choice([k for k in c.fg if k != col])
        c.node([line(ell_d(x, y, R * 1.8, R * 0.42), ring, R * 0.12),
                fill(circ_d(x, y, R), col),
                line(f"M{f(x - R * 1.8)},{f(y)} A{f(R * 1.8)},{f(R * 0.42)} 0 0 0 {f(x + R * 1.8)},{f(y)}", ring, R * 0.12, cap="butt")],
               tilt, (x, y), [sway(c, c.mr.uniform(3, 6), 14, 22), bob(c, 0, R * 0.1, 10, 16)])
    c.node([fill(circ_d(mx, my, mR), c.fg[0]), fill(circ_d(mx + mR * 0.35, my - mR * 0.2, mR * 0.85), c.bg)], 0, (mx, my),
           [orbit(c, c.u * 0.04, c.u * 0.02, 50, 70)])
    c.fx.append({"k": "comets", "c": c.fg[-1], "every": 7})

def truchet(c, r):
    cols = c.n(r.choice([10, 12, 14]), lo=3)
    s = c.w / cols
    rows = math.ceil(c.h / s)
    oy = (c.h - rows * s) / 2
    a, b = r.sample(c.fg, 2) if len(c.fg) > 1 else (c.fg[0], c.bg)
    q = s / 2 + 0.75
    c.rect(-2, -2, c.w + 4, c.h + 4, a)
    for j in range(rows):
        for i in range(cols):
            x, y = i * s, oy + j * s
            turn = 0 if r.random() < 0.5 else 90
            wedges = (f"M{f(x)},{f(y)} L{f(x + q)},{f(y)} A{f(q)},{f(q)} 0 0 1 {f(x)},{f(y + q)} Z "
                      f"M{f(x + s)},{f(y + s)} L{f(x + s - q)},{f(y + s)} A{f(q)},{f(q)} 0 0 1 {f(x + s)},{f(y + s - q)} Z")
            c.node([fill(wedges, b)], turn, (x + s / 2, y + s / 2),
                   [flip(c, 22, 65)])
    accent = [k for k in c.fg if k not in (a, b)] or [c.bg]
    for _ in range(cols * max(1, rows // 6)):
        i, j = r.randrange(cols), r.randrange(rows)
        c.circle(i * s + s / 2, oy + j * s + s / 2, s * 0.14, r.choice(accent), [breathe(c, 0.2, 3, 5)])

def memphis(c, r):
    placed = []
    items = 0
    tries = 0
    u = c.u / 14
    while items < c.n(34, 2, hi=300) and tries < c.n(3000, 2, hi=40000):
        tries += 1
        x, y = r.uniform(0, c.w), r.uniform(0, c.h)
        if not all(math.hypot(x - px, y - py) > u * 2.6 for px, py in placed):
            continue
        placed.append((x, y))
        items += 1
        col = r.choice(c.fg)
        rot = r.uniform(0, 360)
        kind = r.choice(["squiggle", "zigzag", "tri", "nyri", "moon", "ring", "bar"])
        sw = u * 0.28
        m = [sway(c, c.mr.uniform(8, 16), 2.5, 5), bob(c, 0, u * 0.25, 3, 6)]
        if kind == "squiggle":
            pts = [(x - 1.6 * u + k * u * 0.4, y + (u * 0.35 if k % 2 else -u * 0.35)) for k in range(9)]
            c.node([line(smooth(pts, closed=False), col, sw)], rot, (x, y), m)
        elif kind == "zigzag":
            d = "M" + " L".join(f"{f(x - 1.4 * u + k * u * 0.4)},{f(y + (u * 0.3 if k % 2 else -u * 0.3))}" for k in range(8))
            c.node([line(d, col, sw)], rot, (x, y), m)
        elif kind == "tri":
            R = u * 0.9
            d = "M" + " L".join(f"{f(x + R * math.cos(a))},{f(y + R * math.sin(a))}" for a in (0, 2.094, 4.189)) + " Z"
            c.node([fill(d, col), line(d, col, u * 0.25)], rot, (x, y), m)
        elif kind == "nyri":
            c.node([fill(" ".join(circ_d(x + (dx - 1) * u * 0.55, y + (dy - 1) * u * 0.55, u * 0.12) for dx in range(3) for dy in range(3)), col)],
                   rot, (x, y), m)
        elif kind == "moon":
            R = u * 0.9
            c.node([fill(f"M{f(x - R)},{f(y)} A{f(R)},{f(R)} 0 0 1 {f(x + R)},{f(y)} Z", col)], rot, (x, y), m)
        elif kind == "ring":
            c.node([line(circ_d(x, y, u * 0.7), col, sw)], 0, (x, y), [breathe(c, 0.12, 2.5, 4.5), m[1]])
        else:
            c.node([fill(rrect_d(x - u, y - u * 0.18, 2 * u, u * 0.36, u * 0.18), col)], rot, (x, y), m)

def sunset(c, r):
    ink = sorted(c.fg, key=luminance)
    dark_bg = luminance(c.bg) < 0.5
    sun = ink[-1] if dark_bg else ink[0] if luminance(ink[0]) < luminance(c.bg) - 0.25 else ink[-1]
    rest = [k for k in c.fg if k != sun] or [c.bg]
    sky = [c.bg] + sorted(rest, key=luminance, reverse=not dark_bg)[:2]
    horizon = c.h * r.uniform(0.6, 0.66)
    water = max([k for k in [c.bg] + c.fg if k not in (sun, sky[-1])] or rest, key=lambda k: abs(luminance(k) - luminance(sun)))
    band_h = horizon / len(sky)
    for k, col in enumerate(sky):
        c.rect(0, k * band_h, c.w, band_h + 1, col)
    cx, R = c.w * r.uniform(0.35, 0.65), c.u * r.uniform(0.24, 0.3)
    c.circle(cx, horizon, R, sun, [bob(c, 0, R * 0.09, 26, 34, ph=0)])
    y = horizon - R * 0.6
    for k in range(5):
        gap = R * 0.03 * (k + 1.5)
        band = sky[min(len(sky) - 1, int(y // band_h))]
        c.rect(cx - R - 2, y, 2 * R + 4, gap, band)
        y += gap + R * 0.08
    c.rect(0, horizon, c.w, c.h - horizon + 1, water)
    for k in range(6):
        w = 2 * R * (0.9 - k * 0.13)
        yy = horizon + c.u * 0.035 + k * c.u * 0.045
        c.rect(cx - w / 2, yy, w, c.u * 0.014, sun, c.u * 0.007, m=[stretch(c, 0.1 + k * 0.03, 2.2, 4)])

def peaks(c, r):
    layers = sorted(c.fg, key=luminance, reverse=luminance(c.bg) < 0.5)
    while len(layers) < 4:
        layers.append(layers[-1])
    snow = max([c.bg] + c.fg, key=luminance)
    moon = snow if luminance(c.bg) < 0.5 else layers[0]
    c.circle(c.w * r.uniform(0.15, 0.85), c.h * r.uniform(0.14, 0.26), c.u * 0.07, moon, [orbit(c, c.u * 0.06, c.u * 0.025, 60, 90)])
    for k, col in enumerate(layers[:4]):
        base = c.h * (0.5 + 0.14 * k)
        n = c.n(r.choice([3, 4, 5]) + k, lo=2, hi=60)
        step = c.w * 1.1 / n
        pts = []
        for i in range(n + 1):
            x = -c.w * 0.05 + i * step
            peak = (x + step * r.uniform(0.3, 0.7), base - c.u * r.uniform(0.14, 0.3) / (1 + k * 0.35))
            valley = (x + step, base - c.h * r.uniform(0.0, 0.06))
            pts += [peak, valley]
        d = f"M{f(-c.w * 0.05)},{f(c.h + 10)} L{f(-c.w * 0.05)},{f(base)} " + " ".join(f"L{f(x)},{f(y)}" for x, y in pts) + f" L{f(c.w * 1.1)},{f(c.h + 10)} Z"
        c.path(d, col)
        if k < 2:
            prev = (-c.w * 0.05, base)
            for i in range(0, len(pts) - 1, 2):
                (px, py), (vx, vy) = pts[i], pts[i + 1]
                lx, ly = prev
                t = 0.24
                a = (px + (lx - px) * t, py + (ly - py) * t)
                b = (px + (vx - px) * t, py + (vy - py) * t)
                m = (px + (a[0] + b[0] - 2 * px) * 0.25, (a[1] + b[1]) / 2 + (b[1] - py) * 0.1)
                c.path(f"M{f(px)},{f(py)} L{f(b[0])},{f(b[1])} L{f(m[0])},{f(m[1])} L{f(a[0])},{f(a[1])} Z", snow)
                prev = (vx, vy)

def flowers(c, r):
    placed = []
    tries = 0
    while len(placed) < c.n(7, 2) and tries < c.n(800, 2, hi=20000):
        tries += 1
        R = c.u * r.uniform(0.18, 0.34)
        x, y = r.uniform(-R * 0.3, c.w + R * 0.3), r.uniform(-R * 0.3, c.h + R * 0.3)
        if not all(math.hypot(x - px, y - py) > (R + pr) * 0.8 for px, py, pr in placed):
            continue
        placed.append((x, y, R))
        petals, depth = r.choice([(5, 0.22), (6, 0.2), (8, 0.14), (4, 0.3)])
        col = r.choice(c.fg)
        petal = polar(x, y, lambda t, R=R, n=petals, a=depth: R * (1 - a + a * abs(math.cos(n * t / 2)) ** 0.7), 160, r.uniform(0, 6))
        c.node([fill(petal, col), fill(circ_d(x, y, R * 0.3), r.choice([k for k in [c.bg] + c.fg if k != col]))], 0, (x, y),
               [spin(c, 2.5, 7), breathe(c, 0.03, 6, 9)])

def rings(c, r):
    k = c.n(r.choice([2, 3]), lo=1, hi=12)
    centres = [(c.w * (i + r.uniform(0.2, 0.8)) / k, c.h * r.uniform(0.1, 0.9)) for i in range(k)]
    for (x, y) in centres:
        n = r.choice([5, 6, 7])
        R = c.u * r.uniform(0.45, 0.75)
        seq = r.sample(c.fg, len(c.fg))
        p = c.mr.uniform(6, 9)
        for k in range(n):
            c.node([fill(circ_d(x, y, R * (1 - k / n)), seq[k % len(seq)] if k % 2 == 0 else c.bg)], 0, (x, y),
                   [breathe(c, 0.05 / (1 + k * 0.3), p, p, ph=-k * 0.6)])

def stripes(c, r):
    ang = r.choice([-30, 30, -45, 45])
    w = c.u * r.uniform(0.07, 0.1)
    step = w * 1.5
    L = math.hypot(c.w, c.h)
    c.group([["translate", c.w / 2, c.h / 2], ["rotate", ang, 0, 0]])
    y = -L / 2
    k = 0
    lane = 0
    while y < L / 2:
        x = -L / 2
        segs = []
        while x < L / 2:
            seg = r.uniform(0.15, 0.5) * L * min(1.5, c.k)
            if r.random() < 0.8:
                segs.append((x, seg, c.fg[k % len(c.fg)]))
            x += seg + w
            k += 1
        P = x + L / 2
        ps = [fill(rrect_d(sx + dx, y, sl, w, w / 2), col) for dx in (-P, 0, P) for sx, sl, col in segs]
        speed = c.mr.uniform(14, 30) * c.w / 2880 * (1 if lane % 2 else -1)
        c.node(ps, 0, (0, y), [{"k": "scroll", "v": round(speed, 2), "P": round(P, 1)}])
        y += step
        lane += 1
    c.end()

def bands(c, r):
    colors = [c.bg] + c.fg
    for i, color in enumerate(colors):
        y0 = c.h * i / len(colors)
        y1 = c.h * (i + 1) / len(colors)
        c.rect(0, y0, c.w, y1 - y0 + 0.5, color)

def garden(c, r):
    ink = sorted(c.fg, key=luminance)
    stem = ink[0] if luminance(c.bg) > 0.5 else ink[-1]
    ground_y = c.h * r.uniform(0.76, 0.84)
    if r.random() < 0.6:
        hill = [(x, ground_y - c.h * r.uniform(0.04, 0.12)) for x in [c.w * t / 5 for t in range(-1, 7)]]
        c.path(smooth(hill, closed=False) + f" L{f(c.w + 40)},{f(c.h + 40)} L{f(-40)},{f(c.h + 40)} Z", r.choice(c.fg))
    if r.random() < 0.6:
        c.circle(c.w * r.uniform(0.12, 0.88), c.h * r.uniform(0.12, 0.24), c.u * r.uniform(0.07, 0.11), r.choice(c.fg), [breathe(c, 0.03, 8, 12)])
    n = c.n(r.choice([5, 6, 7, 8]), lo=2, hi=60)
    heads = [c.fg[i % len(c.fg)] for i in range(n)]
    r.shuffle(heads)
    gust = c.mr.uniform(4.5, 6.5)
    for i in range(n):
        x = c.w * (0.08 + 0.84 * (i + r.uniform(-0.3, 0.3)) / (n - 1))
        hgt = min(c.h * 0.7, c.u * r.uniform(0.2, 0.46))
        bend = hgt * r.uniform(-0.14, 0.14)
        sw = c.u * r.uniform(0.012, 0.018)
        top = (x + bend, ground_y - hgt)
        ps = [line(f"M{f(x)},{f(ground_y + 40)} Q{f(x + bend * 0.2)},{f(ground_y - hgt * 0.5)} {f(top[0])},{f(top[1])}", stem, sw)]
        for _ in range(r.choice([1, 2])):
            k = r.uniform(0.3, 0.6)
            lx, ly = x + bend * k * k, ground_y - hgt * k
            side = r.choice([-1, 1])
            L = c.u * r.uniform(0.06, 0.09)
            ps.append(fill(rrect_d(lx if side > 0 else lx - L, ly - L * 0.18, L, L * 0.36, L * 0.18, side * r.uniform(-50, -25), (lx, ly)), stem))
        R = c.u * r.uniform(0.06, 0.11)
        petals, depth = r.choice([(5, 0.25), (6, 0.2), (8, 0.14), (12, 0.08)])
        col = heads[i]
        ps.append(fill(polar(top[0], top[1], lambda t, R=R, n=petals, a=depth: R * (1 - a + a * abs(math.cos(n * t / 2)) ** 0.7), 120, r.uniform(0, 6)), col))
        ps.append(fill(circ_d(top[0], top[1], R * r.uniform(0.25, 0.35)), r.choice([k for k in [c.bg] + c.fg if k != col])))
        c.node(ps, 0, (x, ground_y), [sway(c, c.mr.uniform(1.8, 3.5), gust, gust, ph=-x / c.w * 4)])
    c.rect(-20, ground_y, c.w + 40, c.h - ground_y + 20, stem if r.random() < 0.3 else r.choice(c.fg))

def objects(c, r):
    light = max([c.bg] + c.fg, key=luminance)
    u = c.u
    for (a, b, rad) in ((0.1, 0.8, 0.22), (0.86, 0.26, 0.28)):
        x, y = c.w * a + c.w * r.uniform(-0.04, 0.04), c.h * b + c.h * r.uniform(-0.05, 0.05)
        c1, c2 = r.sample(c.fg, 2) if len(c.fg) > 1 else (c.fg[0], c.bg)
        R = u * rad
        rot = r.uniform(0, 360)
        c.node([fill(f"M{f(x - R)},{f(y)} A{f(R)},{f(R)} 0 0 1 {f(x + R)},{f(y)} Z", c1),
                fill(f"M{f(x + R)},{f(y)} A{f(R)},{f(R)} 0 0 1 {f(x - R)},{f(y)} Z", c2)], rot, (x, y), [spin(c, 4, 8)])
        c.node([line(circ_d(x, y, R * 2.4), light, u * 0.005, op=0.55)], 0, (x, y), [breathe(c, 0.03, 9, 13)])
    placed = []
    tries = 0
    while len(placed) < c.n(11, 2) and tries < c.n(900, 2, hi=20000):
        tries += 1
        x, y = c.w * r.uniform(0.22, 0.74), c.h * r.uniform(0.1, 0.9)
        if not all(math.hypot(x - px, y - py) > u * 0.16 for px, py in placed):
            continue
        placed.append((x, y))
        col = r.choice(c.fg)
        other = r.choice([k for k in [c.bg] + c.fg if k != col])
        rot = r.uniform(0, 360)
        k = u * r.uniform(0.9, 1.2)
        kind = r.randrange(5)
        m = [sway(c, c.mr.uniform(10, 22), 4, 8), bob(c, 0, k * 0.02, 5, 9)]
        if kind == 0:
            pts = [(x - 0.07 * k, y + 0.1 * k), (x - 0.07 * k, y - 0.03 * k), (x, y - 0.1 * k), (x + 0.07 * k, y - 0.03 * k), (x + 0.07 * k, y + 0.05 * k)]
            c.node([line(smooth(pts, closed=False), col, k * 0.04),
                    fill(circ_d(pts[0][0], pts[0][1], k * 0.028) + " " + circ_d(pts[-1][0], pts[-1][1], k * 0.028), other)], rot, (x, y), m)
        elif kind == 1:
            pts = [(x - 0.08 * k, y + 0.02 * k), (x, y - 0.025 * k), (x + 0.08 * k, y - 0.01 * k)]
            c.node([line(smooth(pts, closed=False), col, k * 0.07), fill(circ_d(x + 0.07 * k, y - 0.01 * k, k * 0.018), other)], rot, (x, y), m)
        elif kind == 2:
            c.node([fill(rrect_d(x - 0.0375 * k, y - 0.14 * k, 0.075 * k, 0.28 * k, 0.0375 * k), col),
                    fill(rrect_d(x + 0.04 * k, y - 0.14 * k, 0.024 * k, 0.28 * k, 0.012 * k), other)], rot, (x, y), m)
        elif kind == 3:
            c.circle(x, y, k * r.uniform(0.025, 0.045), col, [breathe(c, 0.25, 2.5, 4), m[1]])
        else:
            c.node([fill(polar(x, y, lambda t, R=k * 0.1: R * (1 + 0.1 * math.cos(6 * t)), 72, math.radians(rot)), col)], 0, (x, y),
                   [spin(c, 10, 25), m[1]])

def pair(c, r):
    ax, ay = c.w * r.uniform(0.18, 0.32), c.h * r.uniform(0.68, 0.92)
    bx, by = c.w * r.uniform(0.66, 0.8), c.h * r.uniform(0.08, 0.32)
    ca, cb = r.sample(c.fg, 2) if len(c.fg) > 1 else (c.fg[0], c.bg)
    ang = math.degrees(math.atan2(by - ay, bx - ax))
    dist = math.hypot(bx - ax, by - ay)
    cc = r.choice([k for k in c.fg if k not in (ca, cb)] or [c.bg])
    L, T = dist * r.uniform(0.5, 0.65), c.u * r.uniform(0.2, 0.28)
    mx, my = (ax + bx) / 2, (ay + by) / 2
    way = c.mr.choice([1, -1])
    for idx, (x, y, col, n) in enumerate(((ax, ay, ca, r.choice([9, 12])), (bx, by, cb, r.choice([7, 9, 12])))):
        R = c.u * r.uniform(0.42, 0.55)
        c.node([fill(polar(x, y, lambda t, R=R, n=n: R * (1 + 0.07 * math.cos(n * t)), 160, r.uniform(0, 6)), col)], 0, (x, y),
               [spin(c, 2, 4, sign=way if idx == 0 else -way), breathe(c, 0.02, 9, 12)])
    c.node([fill(rrect_d(mx - L / 2, my - T / 2, L, T, T / 2), cc)], ang, (mx, my))
    k = r.uniform(0.25, 0.45)
    bead_r = c.u * r.uniform(0.11, 0.15)
    ex, ey = ax + (bx - ax) * (0.5 + k * 0.5), ay + (by - ay) * (0.5 + k * 0.5)
    A = max(1.0, L / 2 - T / 2)
    off = math.hypot(ex - mx, ey - my)
    ph = math.asin(max(-1, min(1, off / A)))
    ux, uy = (bx - ax) / dist, (by - ay) / dist
    c.circle(ex, ey, bead_r, r.choice([k2 for k2 in [c.bg] + c.fg if k2 not in (cc, cb)] or [c.bg]),
             [{"k": "bob", "dx": round(ux * A, 2), "dy": round(uy * A, 2), "p": round(c.mr.uniform(9, 13), 2), "ph": round(ph, 3)}])

RENDER = {"bauhaus": bauhaus, "arches": arches, "waves": waves, "hills": hills, "pebbles": pebbles,
          "ribbons": ribbons, "shapes": shapes, "rainbow": rainbow, "dots": dots, "cosmos": cosmos,
          "truchet": truchet, "memphis": memphis, "sunset": sunset, "peaks": peaks, "flowers": flowers,
          "rings": rings, "stripes": stripes, "bands": bands, "garden": garden, "objects": objects, "pair": pair}

def palette_by_name(name):
    base, sep, variant = name.rpartition("/")
    if sep and variant in ("dark", "light"):
        return toned(palette_by_name(base), variant)
    if name.startswith("colors:"):
        colors = name.removeprefix("colors:").split(",")
        if not 2 <= len(colors) <= 16 or any(not re.fullmatch(r"#[0-9a-fA-F]{6}", c) for c in colors):
            raise SystemExit("nyri-wall: palette needs 2–16 valid hex colors")
        return colors
    if name.startswith("#"):
        return custom_palette(name)
    for p in PALETTES:
        if p["name"] == name:
            return p["colors"]
    raise SystemExit(f"nyri-wall: no palette {name!r}")

def build(style, palette, seed, w=W, h=H, grid=False, scale=1.0):
    c = Canvas(w, h, palette_by_name(palette), grid, scale)
    c.mr = random.Random(f"{style}:{seed}:motion")
    RENDER[style](c, random.Random(f"{style}:{seed}"))
    return c

def make(style, palette, seed, w=W, h=H, grid=False, scale=1.0):
    return build(style, palette, seed, w, h, grid, scale).svg()

WALLS = Path(os.environ.get("NYRI_DATA", Path.home() / ".local/share/nyri")) / "walls"

def accent(colors):
    def chroma(h):
        r, g, b = hexrgb(h)
        return colorsys.rgb_to_hls(r, g, b)[2] * (1 - abs(2 * colorsys.rgb_to_hls(r, g, b)[1] - 1))
    return max(colors[1:] or colors, key=chroma)

def stem_for(style, pal, seed, grid=False, scale=1.0):
    if pal.startswith("colors:"):
        tag = "m" + hashlib.sha256(pal.encode()).hexdigest()[:16]
    elif pal.startswith("#"):
        tag = "c" + pal[1:].replace("/", "-")
    else:
        base, _, variant = pal.partition("/")
        tag = "p%02d" % next(i for i, p in enumerate(PALETTES) if p["name"] == base) + (f"-{variant}" if variant else "")
    sc = "" if abs(scale - 1) < 1e-3 else f"-x{scale:g}"
    return WALLS / f"{style}-{tag}-{seed}{'-grid' if grid else ''}{sc}"

def apply(style, pal, seed, grid=False, scale=1.0, env=None):
    WALLS.mkdir(parents=True, exist_ok=True)
    stem = stem_for(style, pal, seed, grid, scale)
    c = build(style, pal, seed, grid=grid, scale=scale)
    Path(f"{stem}.svg").write_text(c.svg())
    Path(f"{stem}.json").write_text(json.dumps(c.scene(), ensure_ascii=False, separators=(",", ":")))
    subprocess.run(["resvg", "--width", str(W), str(Path(f"{stem}.svg")), str(Path(f"{stem}.png"))], check=True)
    (WALLS / "current.json").write_text(json.dumps({"style": style, "palette": pal, "seed": seed, "grid": grid, "scale": scale}, ensure_ascii=False))
    nyri = Path(__file__).resolve().parent
    subprocess.run([str(nyri / "nyri-theme"), str(Path(f"{stem}.png"))], check=True, env=env)
    return Path(f"{stem}.png")

def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    grid = "--grid" in argv
    argv = [a for a in argv if a != "--grid"]
    scale = 1.0
    if "--scale" in argv:
        i = argv.index("--scale")
        scale = float(argv[i + 1])
        del argv[i:i + 2]
    if cmd == "styles":
        print(json.dumps([{"id": i, "title": t, "icon": ic} for i, t, ic in STYLES], ensure_ascii=False))
    elif cmd == "palettes":
        print(json.dumps(PALETTES, ensure_ascii=False))
    elif cmd == "make":
        style, pal, seed, out = argv[2:6]
        w, h = W, H
        if "--size" in argv:
            w, h = map(int, argv[argv.index("--size") + 1].split("x"))
        c = build(style, pal, seed, w, h, grid, scale)
        tmp = out + ".tmp"
        Path(tmp).write_text(c.svg())
        os.replace(tmp, out)
        if "--scene" in argv:
            dest = argv[argv.index("--scene") + 1]
            Path(dest + ".tmp").write_text(json.dumps(c.scene(), ensure_ascii=False, separators=(",", ":")))
            os.replace(dest + ".tmp", dest)
    elif cmd == "thumbs":
        pal, seed, out = argv[2:5]
        Path(out).mkdir(parents=True, exist_ok=True)
        for sid, _, _ in STYLES:
            tmp = Path(out) / f"{sid}.svg.tmp"
            tmp.write_text(make(sid, pal, seed, 960, 600, grid, scale))
            os.replace(tmp, Path(out) / f"{sid}.svg")
    elif cmd == "scene":
        cur = json.loads((WALLS / "current.json").read_text()) if (WALLS / "current.json").exists() else None
        if not cur:
            return 1
        stem = stem_for(cur["style"], cur["palette"], cur["seed"], cur.get("grid", False), cur.get("scale", 1.0))
        png = argv[2] if len(argv) > 2 else f"{stem}.png"
        if png not in (f"{stem}.png", str(stem.with_suffix(".png"))):
            return 1
        c = build(cur["style"], cur["palette"], cur["seed"], grid=cur.get("grid", False), scale=cur.get("scale", 1.0))
        out = Path(png[:-4] + ".json")
        tmp = out.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(c.scene(), ensure_ascii=False, separators=(",", ":")))
        os.replace(tmp, out)
        print(out)
    elif cmd == "apply":
        style, pal, seed = argv[2:5]
        print(apply(style, pal, seed, grid, scale))
    elif cmd == "variant":
        want = argv[2] if len(argv) > 2 else "dark"
        cur = json.loads((WALLS / "current.json").read_text()) if (WALLS / "current.json").exists() else None
        nyri = Path(__file__).resolve().parent
        env = dict(os.environ, NYRI_MODE=want)
        if cur and cur["palette"].endswith("/dark"):
            day = json.loads((WALLS / "day.json").read_text()) if (WALLS / "day.json").exists() else None
            original = day if day and cur["palette"] == day["palette"] + "/dark" else {
                **cur, "palette": cur["palette"][:-5]
            }
            print(apply(original["style"], original["palette"], original["seed"],
                        original.get("grid", False), original.get("scale", 1.0), env))
        else:
            subprocess.run([str(nyri / "nyri-theme")], check=True, env=env)
    else:
        print(__doc__)
        return 2
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv))
