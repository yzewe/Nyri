#!/usr/bin/env python3
"""Talk to greetd and remember whether the last login chose Niri or Hyprland."""
import json
import os
import shutil
import socket
import struct
import sys
from pathlib import Path

SYSTEM_STATE = Path("/var/lib/nyri/login.json")
USER_STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "nyri" / "greeter.json"


def send(sock, payload):
    data = json.dumps(payload).encode()
    sock.sendall(struct.pack("=I", len(data)) + data)


def recvn(sock, size):
    buf = b""
    while len(buf) < size:
        chunk = sock.recv(size - len(buf))
        if not chunk:
            raise RuntimeError("greetd закрыл соединение")
        buf += chunk
    return buf


def recv(sock):
    size = struct.unpack("=I", recvn(sock, 4))[0]
    if size > 1_000_000:
        raise RuntimeError("слишком большой ответ greetd")
    return json.loads(recvn(sock, size))


def writable(path):
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        probe = path.parent / ".nyri-write-test"
        probe.write_text("ok")
        probe.unlink()
        return True
    except OSError:
        return False


def state_path(for_write):
    if for_write:
        if writable(SYSTEM_STATE):
            return SYSTEM_STATE
        if writable(USER_STATE):
            return USER_STATE
        return None
    if SYSTEM_STATE.is_file():
        return SYSTEM_STATE
    return USER_STATE


def bin_for(env_name, *names):
    forced = os.environ.get(env_name) or ""
    if forced and os.path.exists(forced):
        return forced
    for name in names:
        found = shutil.which(name)
        if found:
            return found
    return ""


def load_theme():
    homes = []
    state = os.environ.get("NYRI_STATE")
    if state:
        homes.append(Path(state) / "theme.json")
    home = os.environ.get("HOME")
    if home:
        homes.append(Path(home) / ".local/state/nyri/theme.json")
    for path in (Path("/var/lib/nyri/theme.json"), USER_STATE.parent / "greeter" / "theme.json", *homes):
        if not path.is_file():
            continue
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        colors = data.get("colors") if isinstance(data.get("colors"), dict) else {}
        wall = str(data.get("wallpaper") or "")
        if wall and not os.access(wall, os.R_OK):
            wall = ""
        return {"mode": data.get("mode") or "dark", "wallpaper": wall, "colors": colors}
    return None


def publish():
    home = Path(os.environ.get("HOME") or "")
    state = os.environ.get("NYRI_STATE")
    src = Path(state) / "theme.json" if state else home / ".local/state/nyri/theme.json"
    if not src.is_file():
        src = home / ".local/state/nyri/theme.json"
    if not src.is_file():
        raise RuntimeError("тема пользователя не найдена")
    data = json.loads(src.read_text())
    colors = data.get("colors") if isinstance(data.get("colors"), dict) else {}
    wall_src = Path(str(data.get("wallpaper") or ""))
    dest = Path("/var/lib/nyri")
    if not writable(dest / "theme.json"):
        dest = USER_STATE.parent / "greeter"
    dest.mkdir(parents=True, exist_ok=True)
    wall = ""
    if wall_src.is_file():
        target = dest / ("wallpaper" + (wall_src.suffix or ".img"))
        shutil.copyfile(wall_src, target)
        os.chmod(target, 0o664)
        wall = str(target)
    payload = json.dumps({
        "mode": data.get("mode") or "dark",
        "wallpaper": wall,
        "colors": colors,
    }, ensure_ascii=False) + "\n"
    path = dest / "theme.json"
    temporary = path.with_suffix(".tmp")
    temporary.write_text(payload)
    os.chmod(temporary, 0o664)
    os.replace(temporary, path)


def load_state():
    path = state_path(False)
    data = {}
    if path.is_file():
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            data = {}
    niri = bool(bin_for("NYRI_NIRI_BIN", "niri-session", "niri"))
    hyprland = bool(bin_for("NYRI_HYPR_BIN", "start-hyprland", "Hyprland"))
    session = data.get("session")
    if session not in ("niri", "hyprland"):
        session = "hyprland" if hyprland and not niri else "niri"
    user = data.get("user") or ""
    env_user = os.environ.get("USER") or ""
    own_theme = Path(os.environ.get("HOME") or "") / ".local/state/nyri/theme.json"
    if not user and env_user not in ("", "greeter") and own_theme.is_file():
        user = env_user
    return {
        "user": user,
        "session": session,
        "niri": niri,
        "hyprland": hyprland,
        "theme": load_theme(),
    }


def save_state(user, session):
    if session not in ("niri", "hyprland"):
        raise ValueError("неизвестная сессия")
    path = state_path(True)
    if path is None:
        raise OSError("некуда записать выбор сессии")
    payload = json.dumps({"user": user, "session": session}, ensure_ascii=False) + "\n"
    temporary = path.with_suffix(".tmp")
    temporary.write_text(payload)
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def blank_tty():
    vt = os.environ.get("XDG_VTNR") or "1"
    try:
        fd = os.open(f"/dev/tty{vt}", os.O_WRONLY | os.O_NOCTTY)
    except OSError:
        return
    try:
        os.write(fd, b"\033[?25l\033[2J\033[3J\033[H")
    except OSError:
        pass
    finally:
        os.close(fd)


def session_command(session):
    if session == "niri":
        binary = bin_for("NYRI_NIRI_BIN", "niri-session", "niri")
        if not binary:
            raise RuntimeError("niri не установлен")
    else:
        binary = bin_for("NYRI_HYPR_BIN", "start-hyprland", "Hyprland")
        if not binary:
            raise RuntimeError("Hyprland не установлен")
    return [binary]


def read_request():
    line = sys.stdin.readline()
    if not line.strip():
        raise ValueError("пустой запрос")
    data = json.loads(line)
    if not isinstance(data, dict):
        raise ValueError("запрос должен быть объектом")
    return data


def login(request):
    user = str(request.get("user") or "").strip()
    password = str(request.get("password") or "")
    session = request.get("session")
    if not user or not password:
        raise ValueError("нужны имя и пароль")
    command = session_command(session)
    sock_path = os.environ.get("GREETD_SOCK")
    if not sock_path:
        raise RuntimeError("это проверка экрана, greetd не запущен")
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(sock_path)
    answered = False
    try:
        send(sock, {"type": "create_session", "username": user})
        while True:
            response = recv(sock)
            kind = response.get("type")
            if kind == "auth_message":
                message_type = response.get("auth_message_type")
                reply = password if message_type in ("visible", "secret") and not answered else None
                if message_type in ("visible", "secret"):
                    answered = True
                send(sock, {"type": "post_auth_message_response", "response": reply})
            elif kind == "success":
                break
            else:
                description = response.get("description") or "вход отклонён"
                try:
                    send(sock, {"type": "cancel_session"})
                    recv(sock)
                except (OSError, RuntimeError, ValueError):
                    pass
                raise RuntimeError(description)
        save_state(user, session)
        print(json.dumps({"ok": True, "authed": True}), flush=True)
        blank_tty()
        desktop = "Hyprland" if session == "hyprland" else "niri"
        path = os.environ.get("PATH") or "/run/current-system/sw/bin:/run/wrappers/bin:/usr/bin:/bin"
        send(sock, {
            "type": "start_session",
            "cmd": command,
            "env": [
                "PATH=" + path,
                "XDG_SESSION_TYPE=wayland",
                "XDG_CURRENT_DESKTOP=" + desktop,
                "XDG_SESSION_DESKTOP=" + session,
            ],
        })
        started = recv(sock)
        if started.get("type") != "success":
            raise RuntimeError(started.get("description") or "не удалось запустить сессию")
    finally:
        sock.close()


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "show"
    try:
        if command == "show":
            print(json.dumps(load_state(), ensure_ascii=False))
        elif command == "publish":
            publish()
            print(json.dumps({"ok": True}, ensure_ascii=False))
        elif command == "save":
            request = read_request()
            save_state(str(request.get("user") or ""), request.get("session"))
            print(json.dumps(load_state(), ensure_ascii=False))
        elif command == "login":
            login(read_request())
        else:
            raise ValueError("использование: nyri-greetd show|save|login")
    except (OSError, ValueError, RuntimeError, socket.error) as error:
        print(json.dumps({"ok": False, "error": str(error)}, ensure_ascii=False))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
